# ==========================================
# Plan2Reality Environment Configuration
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/plan2reality

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_characters
JWT_EXPIRES_IN=7d

# File Storage & Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# AI Service Configuration
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
FASTAPI_ENV=development
DEBUG=True

# Real AI Architectural Assistant (Choose Gemini, Groq, or OpenAI)
# Google Gemini API key: Get free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Groq API key: Get free at https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI API key (optional): https://platform.openai.com/api-keys
OPENAI_API_KEY=
